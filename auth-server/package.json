{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "db:create": "tsx src/scripts/db-create.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-strip-types node --test \"src/**/*.test.ts\"",
    "test:integration": "NODE_OPTIONS=--experimental-strip-types node --test \"test/*.it.test.ts\""
  },
  "dependencies": {
    "@propflow/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "mysql2": "^3.10.0",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "sequelize": "^6.37.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
