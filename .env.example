# ─────────────────────────────────────────────────────────────
# PropFlow — environment configuration (copy to .env)
# NEVER commit real secrets. Everything below uses dev-only values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── MySQL (shared server, two logical databases) ─────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=propflow
MYSQL_PASSWORD=propflow-dev-password
# Auth server database (owned by auth-server only)
MYSQL_AUTH_DATABASE=auth_db
# CRM database (owned by crm-api only)
MYSQL_CRM_DATABASE=crm_db
MYSQL_ROOT_PASSWORD=root-dev-password

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Service ports (local dev) ────────────────────────────────
AUTH_PORT=4001
CRM_PORT=4002

# ── Auth / JWT (RS256) ───────────────────────────────────────
JWT_ACCESS_TTL=60s
# PEM contents. For local dev generate with:
#   npm run keys:generate -w auth-server
# Multiline PEMs use \n escapes, e.g. JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
