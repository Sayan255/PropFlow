# ─────────────────────────────────────────────────────────────
# PropFlow — environment configuration (copy to .env)
# NEVER commit real secrets. Everything below uses dev-only values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── MySQL (shared server, two logical databases) ─────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=propflow
MYSQL_PASSWORD=propflow-dev-password
# Auth server database (owned by auth-server only)
MYSQL_AUTH_DATABASE=auth_db
# CRM database (owned by crm-api only)
MYSQL_CRM_DATABASE=crm_db
MYSQL_ROOT_PASSWORD=root-dev-password

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Service ports (local dev) ────────────────────────────────
AUTH_PORT=4001
CRM_PORT=4002

# ── Auth / JWT (RS256) ───────────────────────────────────────
JWT_ACCESS_TTL=60s
# PEM contents. For local dev generate with:
#   npm run keys:generate -w auth-server
# Multiline PEMs use \n escapes, e.g. JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=pf-dev-key-1
# Seconds an invitation link stays valid
INVITE_TTL_HOURS=24

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECURE=false          # true in production (HTTPS only)
COOKIE_SAME_SITE=lax         # lax | strict | none (none requires secure)

# ── URLs / CORS ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
AUTH_URL=http://localhost:4001
CRM_URL=http://localhost:4002

# ── CRM ──────────────────────────────────────────────────────
EXPORT_MAX_ROWS=50000
DASHBOARD_CACHE_TTL_SECONDS=60

# ── Seed (development only!) ─────────────────────────────────
SEED_PASSWORD=Password123!
SEED_SUPERADMIN_EMAIL=superadmin@propflow.local
SEED_TENANTS=2
SEED_PROPERTIES_PER_TENANT=10482

# ── Firebase Hosting (frontend deployment) ───────────────────
# apps/web/firebase.json is preconfigured; deploy with:
#   firebase deploy --only hosting --project <project-id>
FIREBASE_PROJECT=
