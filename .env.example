JWT_PUBLIC_KEY= "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAt3B1p/cqLzaLXBZr0Rl1\nKxHqItvi2flLnEwjFSdfBIPUaNk3WXTAqooT4ftdvlfckVekcNVJSVGroNTz0Bm7\nsHq14A3xuG9q8rrpVvrGj6XQzmWcdk/vXBs3A2qf00zj5DjAEI0QwwfDGY/c8Qeh\nYx7tI/UTw7Y7Kx2Sf9zQrXi4n+yqLaoyM3WQtUyy65KllBgDDQ/kUQ6xTFjlrfPW\ny9AgPmiAjt1XrJ9vQVnl+jFcrkN0QuT48jbFBfM8Zp4fN4g1PHZPp5rf0aJbFFD+\n6DLnZ174Zxq6XHisRbf55RMiN4aHOjF151Na8cLnN46oN83fn/Pwe4a9kjpmLkFq\npwIDAQAB\n-----END PUBLIC KEY-----\n"
