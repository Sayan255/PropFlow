# Seconds an invitation link stays valid
INVITE_TTL_HOURS=24

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECURE=false          # true in production (HTTPS only)
COOKIE_SAME_SITE=lax         # lax | strict | none (none requires secure)

# ── URLs / CORS ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Optional Vite build-time API origin for a separately hosted frontend (e.g. Firebase Hosting).
# Leave blank for same-origin local/edge deployments; never put secrets in VITE_* variables.
VITE_API_ORIGIN= https://propflow-edge.onrender.com
AUTH_URL=http://localhost:4001
CRM_URL=http://localhost:4002

# ── CRM ──────────────────────────────────────────────────────
EXPORT_MAX_ROWS=50000
DASHBOARD_CACHE_TTL_SECONDS=60

# ── Seed (development only!) ─────────────────────────────────
SEED_PASSWORD=Password123!
SEED_SUPERADMIN_EMAIL=superadmin@propflow.local
SEED_TENANTS=2
SEED_PROPERTIES_PER_TENANT=10482

# ── Firebase Hosting (frontend deployment) ───────────────────
# apps/web/firebase.json is preconfigured; deploy with:
#   firebase deploy --only hosting --project <project-id>
FIREBASE_PROJECT= propflow-38327
