# PropFlow — MySQL for Render (private service pattern)
#
# Render has no managed MySQL, so it runs as a private service. This image is
# bitnami/mysql 8.4 with PropFlow's first-boot provisioning script baked in:
# bitnami's entrypoint executes scripts in /docker-entrypoint-initdb.d/ before
# the server accepts connections, creating auth_db + crm_db and granting the
# app user. Persistent data lives on the Render disk at /bitnami/mysql/data.
FROM docker.io/bitnami/mysql:8.4

COPY docker/mysql-provision.sh /docker-entrypoint-initdb.d/01-propflow-provision.sh
