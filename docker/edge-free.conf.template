# PropFlow edge — FREE tier variant.
# Free-plan services are public web services whose IPs change on every
# wake/redeploy, so nginx must resolve upstreams at REQUEST time (variable
# proxy_pass + resolver), not at config load. The Host header must be the
# upstream's hostname: Render's router routes on Host.
limit_req_zone $binary_remote_addr zone=login:10m rate=${LOGIN_RATE_LIMIT};
limit_req_status 429;

resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Health check (Render polls this) ────────────────────────────────────
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "edge ok\n";
    }

    # ── Static SPA (built into this image) ──────────────────────────────────
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    # ── Auth API ────────────────────────────────────────────────────────────
    # Variable proxy_pass does NOT do the static trailing-slash prefix strip,
    # so the /auth-api prefix is removed with an explicit rewrite; auth then
    # sees /auth/... exactly like the Vite dev proxy. The refresh cookie is
    # path-scoped to /auth-api/auth and passes through untouched.
    location = /auth-api/auth/login {
        limit_req zone=login burst=10 nodelay;
        set $auth_host "propflow-free-auth.onrender.com";
        rewrite ^/auth-api(/.*)$ $1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name $auth_host;
        proxy_set_header Host $auth_host;
        proxy_pass https://$auth_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth-api/ {
        set $auth_host "propflow-free-auth.onrender.com";
        rewrite ^/auth-api(/.*)$ $1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name $auth_host;
        proxy_set_header Host $auth_host;
        proxy_pass https://$auth_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── CRM API ─────────────────────────────────────────────────────────────
    location /crm-api/socket.io/ {
        set $crm_host "propflow-free-crm.onrender.com";
        rewrite ^/crm-api(/.*)$ $1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name $crm_host;
        proxy_set_header Host $crm_host;
        proxy_pass https://$crm_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /crm-api/ {
        set $crm_host "propflow-free-crm.onrender.com";
        rewrite ^/crm-api(/.*)$ $1 break;
        proxy_ssl_server_name on;
        proxy_ssl_name $crm_host;
        proxy_set_header Host $crm_host;
        proxy_pass https://$crm_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
