# PropFlow — edge for the FREE tier (single public container).
# The SPA is PREBUILT and committed at apps/web/dist: Render's free builders
# have 512MB RAM and OOM during vite. After changing frontend code, rebuild
# and re-commit before deploying:
#   npx vite build apps/web && git add -f apps/web/dist
# The image serves the SPA statically and proxies /auth-api + /crm-api to the
# auth/crm web services over their public HTTPS URLs (free plan = no private
# DNS, hence the separate Dockerfile.edge does not work here).
FROM nginx:1.27-alpine
# The stock conf.d/default.conf would win the listen-80 race (alphabetical
# load order) and shadow our template's server block — remove it.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/edge-free.conf.template /etc/nginx/templates/edge-free.conf.template
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d
COPY apps/web/dist /usr/share/nginx/html

EXPOSE 80
